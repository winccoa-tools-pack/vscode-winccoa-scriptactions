{
  "name": "winccoa-script-actions",
  "displayName": "WinCC OA Script Actions",
  "description": "Execute WinCC OA CTRL scripts directly from VS Code",
  "version": "0.1.1",
  "publisher": "RichardJanisch",
  "repository": {
    "type": "git",
    "url": "https://github.com/winccoa-tools-pack/vscode-winccoa-scriptactions"
  },
  "bugs": {
    "url": "https://github.com/mPokornyETM/vs-code-wincc-oa-projects-viewer/issues"
  },
  "author": "winccoa-tools-pack",
  "license": "MIT",
  "icon": "resources/play_industrial_calm_128.png",
  "keywords": [
    "wincc-oa",
    "scada",
    "hmi",
    "wincc-oa-script-action",
    "wincc-oa-engineering",
    "wincc-oa-runtime",
    "siemens",
    "etm",
    "industrial",
    "automation"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "winccoa.executeScript",
        "title": "Start Script",
        "category": "WinCC OA"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "winccoa.executeScript",
          "when": "resourceExtname == '.ctl'",
          "group": "winccoa@1"
        }
      ],
      "editor/context": [
        {
          "command": "winccoa.executeScript",
          "when": "resourceExtname == '.ctl'",
          "group": "winccoa@1"
        }
      ]
    },
    "configuration": {
      "title": "WinCC OA Script Actions",
      "properties": {
        "winccoa.scriptActions.pathSource": {
          "type": "string",
          "enum": [
            "static",
            "automatic"
          ],
          "default": "automatic",
          "description": "How to determine WinCC OA installation and project paths",
          "enumDescriptions": [
            "Use manually configured paths (below)",
            "Auto-detect from workspace"
          ]
        },
        "winccoa.scriptActions.installPath": {
          "type": "string",
          "default": "",
          "description": "Path to WinCC OA installation (e.g., C:/Siemens/Automation/WinCC_OA/3.20 or /opt/WinCC_OA/3.20)",
          "markdownDescription": "Path to WinCC OA installation. Only used when `pathSource` is `static`."
        },
        "winccoa.scriptActions.projectName": {
          "type": "string",
          "default": "",
          "description": "WinCC OA project name (e.g., MyProject)",
          "markdownDescription": "WinCC OA project name. Only used when `pathSource` is `static`."
        },
        "winccoaScriptActions.logLevel": {
          "type": "string",
          "enum": [
            "ERROR",
            "WARN",
            "INFO",
            "DEBUG",
            "TRACE"
          ],
          "default": "INFO",
          "description": "Log level for the extension output channel",
          "enumDescriptions": [
            "Only show critical errors",
            "Show errors and warnings",
            "Show errors, warnings, and general information (recommended)",
            "Show detailed debugging information",
            "Show all possible logging information (very verbose)"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --build",
    "compile": "tsc --build",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "style-check": "npm run lint && npm run format:check && npm run lint:md && npm run format:md:check",
    "style-fix": "npm run lint:fix && npm run format && npm run lint:md:fix && npm run format:md",
    "test": "npm run style-check && npm run compile && node ./dist/test/runTest.js",
    "test:integration": "npm run build && node ./dist/test/runTest.js",
    "ci:integration": "npm ci && npm run test:integration",
    "watch": "tsc --build --watch",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^24.10.2",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.50.0",
    "glob": "^13.0.0",
    "markdownlint-cli": "^0.47.0",
    "mocha": "^11.7.5",
    "prettier": "^2.8.8",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "@winccoa-tools-pack/npm-winccoa-core": "^1.1.0"
  }
}
